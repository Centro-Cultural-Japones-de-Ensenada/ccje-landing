---
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/site/PageHero.astro'
import NextPage from '@/components/site/NextPage.astro'
import SlideButton from '@/components/site/SlideButton.astro'
import { links } from '@/data/site'

const courses = [
  { name: 'Básico 1', tag: 'Sabatino', schedule: 'Una clase por semana', length: '2 h 30 min por clase' },
  { name: 'Otros niveles', tag: 'Sabatino', schedule: 'Una clase por semana', length: '2 h por clase' },
  { name: 'Curso de kanji', schedule: 'Dos clases por semana', length: '2 h por clase' },
  { name: 'Semanal', schedule: 'Dos clases por semana', length: '2 h por clase' },
  { name: 'Intersemestral', schedule: 'Según el grupo y el sensei', length: 'Duración variable' },
]
---

<Layout title="Clases" description="Clases presenciales de japonés en Ensenada: Básico 1, otros niveles, kanji, semanal e intersemestral.">
  <PageHero
    href="/clases"
    title={'Aprende\njaponés'}
    intro="Los sistemas de escritura de Japón y el idioma, escrito y hablado. Clases presenciales en grupos pequeños."
  />

  <section aria-labelledby="cursos-titulo" class="px-6 pb-32 md:px-10 md:pb-44">
    <div class="mx-auto grid max-w-[90rem] gap-16 md:grid-cols-12">
      <div data-reveal-group class="md:sticky md:top-32 md:col-span-4 md:self-start">
        <h2 id="cursos-titulo" data-reveal class="eyebrow text-gold-strong">Cursos</h2>
        <p data-reveal class="mt-6 font-serif text-3xl leading-snug">
          Si eres de nuevo ingreso, empiezas en Básico 1.
        </p>
        <p data-reveal class="mt-6 leading-relaxed text-ink-soft">
          Si ya estudiaste japonés, presentas un examen de ubicación sin costo y entras al nivel que dominas.
        </p>
        <div data-reveal class="mt-10">
          <SlideButton href={links.whatsapp} text="Pedir costos y horarios" hoverText="Escríbenos por WhatsApp" variant="ink" external />
        </div>
      </div>

      <div class="md:col-span-7 md:col-start-6">
        <ol data-reveal-group class="border-t border-ink/15">
          {
            courses.map((course, index) => (
              <li data-reveal class="group relative grid grid-cols-[2.5rem_1fr] border-b border-ink/15 py-8 md:grid-cols-[4rem_1fr] md:py-11">
                <span aria-hidden="true" class="pt-2 font-serif text-gold-strong tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                  <h3 class="font-serif text-[clamp(1.9rem,3.2vw,3rem)] leading-none tracking-[-0.02em] transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-2">
                    {course.name}
                    {course.tag && <span class="ml-2 align-middle font-sans text-sm tracking-normal text-ink-soft">{course.tag}</span>}
                  </h3>
                  <p class="text-ink-soft md:text-right">
                    {course.schedule}
                    <span class="block text-sm">{course.length}</span>
                  </p>
                </div>
                <span
                  aria-hidden="true"
                  class="absolute -bottom-px left-0 h-px w-full origin-left scale-x-0 bg-brand transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100"
                />
              </li>
            ))
          }
        </ol>
        <p class="mt-6 text-sm text-ink-soft">Los libros se compran por separado.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="aprendes-titulo" class="on-ink bg-ink px-6 py-32 text-paper md:px-10 md:py-44">
    <div class="mx-auto max-w-[90rem]">
      <div data-reveal-group class="grid gap-10 md:grid-cols-12">
        <p data-reveal class="eyebrow text-paper/75 md:col-span-3 md:pt-4">Qué aprendes</p>
        <h2 id="aprendes-titulo" data-reveal class="font-serif text-[clamp(2.6rem,5.4vw,5.5rem)] leading-[1] tracking-[-0.03em] md:col-span-9">
          Tres escrituras, un idioma
        </h2>
      </div>
      <ul data-reveal-group class="mt-20 grid gap-px overflow-hidden border border-white/15 bg-white/15 md:grid-cols-3">
        <li data-reveal class="bg-ink p-10">
          <p lang="ja" aria-hidden="true" class="font-serif text-7xl leading-none text-brand">あ</p>
          <h3 class="mt-10 font-serif text-3xl">Hiragana</h3>
          <p class="mt-4 leading-relaxed text-paper/75">La escritura base del japonés, con la que empiezas a leer y escribir.</p>
        </li>
        <li data-reveal class="bg-ink p-10">
          <p lang="ja" aria-hidden="true" class="font-serif text-7xl leading-none text-brand">ア</p>
          <h3 class="mt-10 font-serif text-3xl">Katakana</h3>
          <p class="mt-4 leading-relaxed text-paper/75">La escritura de las palabras extranjeras y las onomatopeyas.</p>
        </li>
        <li data-reveal class="bg-ink p-10">
          <p lang="ja" aria-hidden="true" class="font-serif text-7xl leading-none text-brand">字</p>
          <h3 class="mt-10 font-serif text-3xl">Kanji</h3>
          <p class="mt-4 leading-relaxed text-paper/75">Los caracteres que vienen del chino, con su propio curso y caligrafía con tinta.</p>
        </li>
      </ul>
    </div>
  </section>

  <NextPage href="/clases" />
</Layout>
