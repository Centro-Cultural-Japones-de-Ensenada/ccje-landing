---
import { Image } from 'astro:assets'
import Layout from '@/layouts/Layout.astro'
import BackgroundPaths from '@/components/kokonutui/background-paths'
import { BlurRevealText } from '@/components/spaceui/blur-reveal-text'
import StackedCards from '@/components/site/StackedCards'
import { navPages } from '@/data/site'
import emblema from '@/assets/logos/emblema.png'
import danza from '@/assets/fotos/danza-sombrilla.jpg'

const chapters: Record<string, string> = {
  '/nosotros': 'Nuestra historia desde los años treinta y lo que hacemos hoy.',
  '/clases': 'Niveles, horarios y examen de ubicación sin costo.',
  '/actividades': 'Club cultural, entrega de constancias y festivales.',
  '/escuela': 'Salones, biblioteca y profesores certificados.',
  '/contacto': 'Dirección, WhatsApp, correo y redes.',
}

const exploreCards = navPages.map((page) => ({
  kanji: page.kanji,
  reading: page.reading,
  title: page.label,
  text: chapters[page.href],
  href: page.href,
}))
---

<Layout>
  <!-- Inicio -->
  <section data-hero class="relative flex min-h-svh flex-col overflow-hidden">
    <BackgroundPaths
      client:idle
      count={24}
      speed={0.3}
      angle={-7}
      spread={0.9}
      className="absolute inset-0 min-h-0 bg-transparent text-gold dark:bg-transparent dark:text-gold"
    />

    <div class="relative mx-auto flex w-full max-w-[90rem] flex-1 flex-col px-6 pt-28 pb-8 md:px-10">
      <div class="flex items-start justify-between">
        <p data-hero-fade class="eyebrow text-gold-strong">Ensenada · Baja California</p>
        <p data-hero-fade lang="ja" class="hidden font-serif text-lg tracking-[0.6em] text-brand [writing-mode:vertical-rl] md:block">
          日本語学校
        </p>
      </div>

      <div class="flex flex-1 items-center justify-center py-10 md:-mt-10 md:py-2">
        <div data-hero-emblem class="w-[min(58vw,18rem)] md:w-[min(19vw,17rem)]">
          <Image
            data-hero-emblem-img
            src={emblema}
            alt="Emblema del Centro Cultural Japonés de Ensenada"
            widths={[320, 640]}
            sizes="(min-width: 768px) 17rem, 58vw"
            loading="eager"
            fetchpriority="high"
            class="h-auto w-full"
          />
        </div>
      </div>

      <h1 class="font-serif text-[clamp(2.9rem,7.2vw,8.75rem)] leading-[0.95] font-normal tracking-[-0.035em] text-ink">
        <span class="block overflow-hidden pb-[0.06em]"><span data-line class="block">Centro Cultural</span></span>
        <span class="block overflow-hidden pb-[0.06em] md:text-right"
          ><span data-line class="block"
            >Japonés de Ensenada<span class="text-[0.4em] tracking-normal text-ink-soft">, A.C.</span></span
          ></span
        >
      </h1>

      <div class="mt-10 flex items-center justify-between gap-6 border-t border-ink/15 pt-5 text-[15px] text-ink-soft">
        <p data-hero-fade>Asociación civil sin fines de lucro</p>
        <a data-hero-fade href="/nosotros" class="hidden items-center gap-3 text-ink sm:flex">
          Conócenos
          <span class="relative block h-px w-14 overflow-hidden bg-ink/20">
            <span class="absolute inset-0 animate-[slide_2.4s_var(--ease-in-out-quart)_infinite] bg-ink motion-reduce:animate-none"></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Foto -->
  <figure class="relative h-[70svh] overflow-hidden md:h-[92svh]">
    <Image
      data-parallax
      src={danza}
      alt="Bailarina con kimono y sombrilla roja durante una presentación de danza japonesa del Centro"
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
    />
    <figcaption class="absolute right-6 bottom-6 left-6 flex justify-between text-sm text-white md:right-10 md:left-10">
      <span class="rounded-full bg-ink/60 px-3 py-1">Danza tradicional japonesa</span>
      <span lang="ja" aria-hidden="true" class="rounded-full bg-ink/60 px-3 py-1 font-serif">日本舞踊</span>
    </figcaption>
  </figure>

  <!-- Proverbio -->
  <section aria-labelledby="proverbio-titulo" class="on-ink relative overflow-hidden bg-ink text-paper">
    <h2 id="proverbio-titulo" class="sr-only">Proverbio japonés</h2>
    <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-6 py-32 md:grid-cols-12 md:px-10 md:py-44">
      <div lang="ja" class="flex justify-center font-serif text-[clamp(4.5rem,11vw,10rem)] leading-none text-brand [writing-mode:vertical-rl] md:col-span-4">
        <BlurRevealText
          client:visible
          as="span"
          text="晴耕雨読"
          splitBy="characters"
          stagger={0.22}
          duration={1}
          blurAmount="20px"
          className="tracking-[0.2em]"
        />
      </div>
      <figure data-reveal-group class="md:col-span-7 md:col-start-6">
        <blockquote data-reveal class="font-serif text-[clamp(2rem,4.6vw,4.5rem)] leading-[1.1] tracking-[-0.02em]">
          Cultiva cuando esté soleado, lee cuando esté lloviendo.
        </blockquote>
        <figcaption data-reveal class="eyebrow mt-12 flex items-center gap-4 text-paper/75">
          <span class="h-px w-12 bg-brand"></span>
          <span><span lang="ja-Latn">Seikō udoku</span> · Proverbio japonés</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Capítulos -->
  <section aria-labelledby="explora-titulo" class="bg-paper-deep px-6 pt-32 pb-24 md:px-10 md:pt-44">
    <div class="mx-auto max-w-[90rem]">
      <div data-reveal-group class="grid gap-10 md:grid-cols-12">
        <p data-reveal class="eyebrow text-gold-strong md:col-span-3 md:pt-4">Explora</p>
        <h2 id="explora-titulo" data-reveal class="font-serif text-[clamp(2.9rem,6.4vw,6.5rem)] leading-[0.98] tracking-[-0.03em] md:col-span-9">
          Un pedazo de Japón en Ensenada
        </h2>
      </div>

      <StackedCards client:visible cards={exploreCards} className="mt-24 md:mx-auto md:max-w-5xl" />
    </div>
  </section>
</Layout>
