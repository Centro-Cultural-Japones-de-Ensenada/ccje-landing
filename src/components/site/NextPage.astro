---
import { nextPage } from '@/data/site'

interface Props {
  href: string
}

const next = nextPage(Astro.props.href)
---

<section class="border-t border-ink/15 px-6 md:px-10">
  <a href={next.href} class="group mx-auto flex max-w-[90rem] flex-col gap-6 py-24 md:flex-row md:items-end md:justify-between md:py-32">
    <div>
      <p class="eyebrow text-gold-strong">Siguiente</p>
      <p class="mt-6 font-serif text-[clamp(3rem,8vw,8rem)] leading-none tracking-[-0.035em] transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-4">
        {next.label}
      </p>
    </div>
    <p class="flex items-center gap-6">
      <span lang="ja" aria-hidden="true" class="font-serif text-5xl text-brand md:text-6xl">{next.kanji}</span>
      <span class="relative block h-px w-20 overflow-hidden bg-ink/20 md:w-32">
        <span class="absolute inset-0 origin-left scale-x-0 bg-ink transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100"></span>
      </span>
    </p>
  </a>
</section>
